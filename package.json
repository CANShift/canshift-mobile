{
  "name": "canshift-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node ./scripts/check-overrides.js",
    "prepare": "husky",
    "lint:pre-commit": "lint-staged",
    "e2e:workshop": "tsx scripts/workshop-ota-e2e.ts"
  },
  "dependencies": {
    "@canshift/core": "^12.0.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "buffer": "^6.0.3",
    "expo": "~56.0.23",
    "expo-asset": "~56.0.25",
    "expo-audio": "~56.0.13",
    "expo-battery": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-file-system": "~56.0.11",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-location": "~56.0.26",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "0.8.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "postcss": "^8.5.3",
    "@xmldom/xmldom": "0.8.15",
    "markdown-it": ">=12.3.2",
    "@tootallnate/once": ">=3.0.1",
    "nanoid": "^3.3.18"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "buffer"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "knip": "6.42.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.3",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": "prettier --write --ignore-unknown",
    "*.{js,ts,tsx}": "eslint --fix --no-warn-ignored"
  }
}
