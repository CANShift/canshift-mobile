{
  "expo": {
    "name": "CANShift",
    "slug": "canshift-mobile",
    "version": "0.1.0",
    "scheme": "canshift",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#201E1D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.tmbk.canshift",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CANShift uses Bluetooth to connect to the dashboard device for live data and configuration.",
        "NSLocalNetworkUsageDescription": "CANShift connects to your dash over its own Wi-Fi to install firmware updates.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true
      }
    },
    "android": {
      "package": "ch.tmbk.canshift",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#201E1D"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withSilencePodsWarnings",
      "./plugins/withPodsDeploymentTarget",
      "./plugins/withBluetoothScanNeverForLocation",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "CANShift uses Bluetooth to connect to the dashboard device for live data and configuration."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CANShift uses your location to record laps and detect start/finish crossings on the circuit."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
